,\"#ed7953\"],[0.7777777777777778,\"#fb9f3a\"],[0.8888888888888888,\"#fdca26\"],[1.0,\"#f0f921\"]],\"sequentialminus\":[[0.0,\"#0d0887\"],[0.1111111111111111,\"#46039f\"],[0.2222222222222222,\"#7201a8\"],[0.3333333333333333,\"#9c179e\"],[0.4444444444444444,\"#bd3786\"],[0.5555555555555556,\"#d8576b\"],[0.6666666666666666,\"#ed7953\"],[0.7777777777777778,\"#fb9f3a\"],[0.8888888888888888,\"#fdca26\"],[1.0,\"#f0f921\"]]},\"colorway\":[\"#636efa\",\"#EF553B\",\"#00cc96\",\"#ab63fa\",\"#FFA15A\",\"#19d3f3\",\"#FF6692\",\"#B6E880\",\"#FF97FF\",\"#FECB52\"],\"font\":{\"color\":\"#2a3f5f\"},\"geo\":{\"bgcolor\":\"white\",\"lakecolor\":\"white\",\"landcolor\":\"white\",\"showlakes\":true,\"showland\":true,\"subunitcolor\":\"#C8D4E3\"},\"hoverlabel\":{\"align\":\"left\"},\"hovermode\":\"closest\",\"mapbox\":{\"style\":\"light\"},\"margin\":{\"b\":0,\"l\":0,\"r\":0,\"t\":30},\"paper_bgcolor\":\"white\",\"plot_bgcolor\":\"white\",\"polar\":{\"angularaxis\":{\"gridcolor\":\"#EBF0F8\",\"linecolor\":\"#EBF0F8\",\"ticks\":\"\"},\"bgcolor\":\"white\",\"radialaxis\":{\"gridcolor\":\"#EBF0F8\",\"linecolor\":\"#EBF0F8\",\"ticks\":\"\"}},\"scene\":{\"xaxis\":{\"backgroundcolor\":\"white\",\"gridcolor\":\"#DFE8F3\",\"gridwidth\":2,\"linecolor\":\"#EBF0F8\",\"showbackground\":true,\"ticks\":\"\",\"zerolinecolor\":\"#EBF0F8\"},\"yaxis\":{\"backgroundcolor\":\"white\",\"gridcolor\":\"#DFE8F3\",\"gridwidth\":2,\"linecolor\":\"#EBF0F8\",\"showbackground\":true,\"ticks\":\"\",\"zerolinecolor\":\"#EBF0F8\"},\"zaxis\":{\"backgroundcolor\":\"white\",\"gridcolor\":\"#DFE8F3\",\"gridwidth\":2,\"linecolor\":\"#EBF0F8\",\"showbackground\":true,\"ticks\":\"\",\"zerolinecolor\":\"#EBF0F8\"}},\"shapedefaults\":{\"line\":{\"color\":\"#2a3f5f\"}},\"ternary\":{\"aaxis\":{\"gridcolor\":\"#DFE8F3\",\"linecolor\":\"#A2B1C6\",\"ticks\":\"\"},\"baxis\":{\"gridcolor\":\"#DFE8F3\",\"linecolor\":\"#A2B1C6\",\"ticks\":\"\"},\"bgcolor\":\"white\",\"caxis\":{\"gridcolor\":\"#DFE8F3\",\"linecolor\":\"#A2B1C6\",\"ticks\":\"\"}},\"title\":{\"x\":0.05},\"xaxis\":{\"automargin\":true,\"gridcolor\":\"#EBF0F8\",\"linecolor\":\"#EBF0F8\",\"ticks\":\"\",\"title\":{\"standoff\":15},\"zerolinecolor\":\"#EBF0F8\",\"zerolinewidth\":2},\"yaxis\":{\"automargin\":true,\"gridcolor\":\"#EBF0F8\",\"linecolor\":\"#EBF0F8\",\"ticks\":\"\",\"title\":{\"standoff\":15},\"zerolinecolor\":\"#EBF0F8\",\"zerolinewidth\":2}}},\"margin\":{\"l\":10,\"r\":10,\"t\":30,\"b\":10},\"legend\":{\"orientation\":\"h\",\"y\":1.12,\"x\":0,\"title\":{}},\"font\":{\"size\":13},\"height\":420,\"hovermode\":\"x unified\",\"xaxis\":{\"title\":{}},\"yaxis\":{\"title\":{\"text\":\"unidades\"}}},                        {\"displaylogo\": false, \"locale\": \"es\", \"responsive\": true, \"modeBarButtonsToRemove\": [\"select2d\", \"lasso2d\", \"autoScale2d\"], \"toImageButtonOptions\": {\"format\": \"png\", \"scale\": 2}}                    )                };            </script>        </div>\n```\n:::\n\n::: {.cell-output .cell-output-stdout}\n```\nfenómeno del catálogo: quiebre-de-nivel\nobservaciones: 34 · frecuencia: anual\n```\n:::\n:::\n\n\nLa serie crece de forma sostenida y en algún punto cambia de nivel de golpe, sin\nvolver al anterior. El catálogo la etiqueta como `quiebre-de-nivel`.\n\nLo que importa del ejercicio: un quiebre de nivel se reconoce a ojo con\nfacilidad y arruina a cualquier método que suponga que el pasado lejano informa\nsobre el futuro. La media, por ejemplo, queda anclada a un nivel que ya no\nexiste.\n\n### Ejercicio 2\n\n::: {#e7ab4c8a .cell execution_count=3}\n``` {.python .cell-code}\nserie = cargar(\"Q1915\")\ny = serie.entrenamiento.to_numpy()\nreal = serie.prueba.to_numpy()\nh, m = serie.horizonte, serie.periodo_estacional\n\nresultados = pd.Series({\n    \"naive\": smape(real, naive(y, h)),\n    \"naive estacional\": smape(real, naive_estacional(y, h, m)),\n    \"media\": smape(real, media(y, h)),\n    \"deriva\": smape(real, deriva(y, h)),\n}).sort_values()\n\nresultados.round(2).to_frame(\"sMAPE\")\n```\n\n::: {.cell-output .cell-output-display execution_count=3}\n```{=html}\n<div>\n<style scoped>\n    .dataframe tbody tr th:only-of-type {\n        vertical-align: middle;\n    }\n\n    .dataframe tbody tr th {\n        vertical-align: top;\n    }\n\n    .dataframe thead th {\n        text-align: right;\n    }\n</style>\n<table border=\"1\" class=\"dataframe\">\n  <thead>\n    <tr style=\"text-align: right;\">\n      <th></th>\n      <th>sMAPE</th>\n    </tr>\n  </thead>\n  <tbody>\n    <tr>\n      <th>deriva</th>\n      <td>0.41</td>\n    </tr>\n    <tr>\n      <th>naive</th>\n      <td>2.56</td>\n    </tr>\n    <tr>\n      <th>naive estacional</th>\n      <td>3.46</td>\n    </tr>\n    <tr>\n      <th>media</th>\n      <td>37.11</td>\n    </tr>\n  </tbody>\n</table>\n</div>\n```\n:::\n:::\n\n\n`Q1915` es la serie de tendencia limpia del catálogo, así que la deriva —el único\nde los cuatro métodos que extrapola una pendiente— es la que mejor le va, y la\nmedia es la peor: promediar una serie que crece devuelve un valor que la serie\ndejó atrás hace tiempo.\n\n### Ejercicio 3\n\n::: {#2667e5c2 .cell execution_count=4}\n``` {.python .cell-code}\nserie = cargar(frecuencia=\"diaria\", fenomeno=\"caminata-aleatoria\")\ny = serie.entrenamiento.to_numpy()\nreal = serie.prueba.to_numpy()\nh = serie.horizonte\n\ncomparacion = pd.Series({\n    \"naive simple\": smape(real, naive(y, h)),\n    \"naive estacional, m = 1 (M4)\": smape(real, naive_estacional(y, h, 1)),\n    \"naive estacional, m = 7 (calendario)\": smape(real, naive_estacional(y, h, 7)),\n}).round(3)\n\ncomparacion.to_frame(\"sMAPE\")\n```\n\n::: {.cell-output .cell-output-display execution_count=4}\n```{=html}\n<div>\n<style scoped>\n    .dataframe tbody tr th:only-of-type {\n        vertical-align: middle;\n    }\n\n    .dataframe tbody tr th {\n        vertical-align: top;\n    }\n\n    .dataframe thead th {\n        text-align: right;\n    }\n</style>\n<table border=\"1\" class=\"dataframe\">\n  <thead>\n    <tr style=\"text-align: right;\">\n      <th></th>\n      <th>sMAPE</th>\n    </tr>\n  </thead>\n  <tbody>\n    <tr>\n      <th>naive simple</th>\n      <td>16.970</td>\n    </tr>\n    <tr>\n      <th>naive estacional, m = 1 (M4)</th>\n      <td>16.970</td>\n    </tr>\n    <tr>\n      <th>naive estacional, m = 7 (calendario)</th>\n      <td>15.397</td>\n    </tr>\n  </tbody>\n</table>\n</div>\n```\n:::\n:::\n\n\nCon `m = 1` el naive estacional **es** el naive simple: repetir el último ciclo\nde largo 1 es repetir la última observación. Los dos primeros valores coinciden\npor construcción, no por casualidad.\n\nCon `m = 7` el resultado suele ser algo peor, y la razón es la del\n@sec-a-escala: en una serie sin estructura semanal, usar los últimos siete\nvalores en vez del último agrega ruido sin agregar señal.\n\nSobre la última pregunta: no, no contradice la decisión de M4 — la respalda. M4\ndeclaró las series diarias no estacionales porque en su mayoría no tienen ciclo\nsemanal explotable. Lo que sí hay que retener es que esto vale **en promedio\nsobre el conjunto de M4**, no en toda serie diaria del mundo: la demanda\nminorista diaria tiene un ciclo semanal fortísimo. La convención es una\npropiedad de este conjunto de datos, no una ley.\n\n### Ejercicio 4\n\nLa muestra se toma de la tabla de metadatos, que ya trae el error del naive\ncalculado para cada serie de M4. Así el ejercicio no depende de bajar 30 series\ncompletas, y se puede resolver sin conexión:\n\n::: {#31b49573 .cell execution_count=5}\n``` {.python .cell-code}\npoblacion = metadatos()\npoblacion = poblacion[\n    (poblacion[\"frecuencia\"] == \"mensual\") & poblacion[\"error_naive_smape\"].notna()\n]\n\nmuestra_df = (\n    poblacion.sample(n=30, random_state=42)\n    .rename(columns={\"complexity_index\": \"complejidad\",\n                     \"error_naive_smape\": \"smape_naive\"})\n    [[\"serie\", \"complejidad\", \"smape_naive\"]]\n)\n\ncorrelacion = muestra_df[\"complejidad\"].corr(muestra_df[\"smape_naive\"])\n\nfig = go.Figure()\nfig.add_trace(go.Scatter(\n    x=muestra_df[\"complejidad\"], y=muestra_df[\"smape_naive\"],\n    mode=\"markers\", marker=dict(size=9, color=COLORES[\"observado\"]),\n    text=muestra_df[\"serie\"],\n    hovertemplate=\"%{text}<br>complejidad %{x:.2f}<br>sMAPE %{y:.1f}<extra></extra>\",\n))\nfig.update_layout(height=420, showlegend=False)\nfig.update_xaxes(title=\"índice de complejidad\")\nmostrar(fig, titulo_y=\"sMAPE del naive\")\n\ncorrelacion_total = poblacion[\"complexity_index\"].corr(poblacion[\"error_naive_smape\"])\n\nprint(f\"correlación con 30 series: {correlacion:+.3f}\")\nprint(f\"correlación con las {len(poblacion):,} series mensuales: {correlacion_total:+.3f}\")\n```\n\n::: {.cell-output .cell-output-display}\n```{=html}\n<div style=\"height:420px; width:100%;\">                            <div id=\"af3c6294-7999-45c6-a4c5-6d9280afdd26\" class=\"plotly-graph-div\" style=\"height:100%; width:100%;\"></div>            <script>                window.PLOTLYENV=window.PLOTLYENV || {};                                if (document.getElementById(\"af3c6294-7999-45c6-a4c5-6d9280afdd26\")) {                    Plotly.newPlot(                        \"af3c6294-7999-45c6-a4c5-6d9280afdd26\",                        [{\"hovertemplate\":\"%{text}\\u003cbr\\u003ecomplejidad %{x:.2f}\\u003cbr\\u003esMAPE %{y:.1f}\\u003cextra\\u003e\\u003c\\u002fextra\\u003e\",\"marker\":{\"color\":\"#1f4e79\",\"size\":9},\"mode\":\"markers\",\"text\":[\"M32772\",\"M39513\",\"M43582\",\"M2976\",\"M3378\",\"M3793\",\"M34124\",\"M19848\",\"M10422\",\"M28534\",\"M35123\",\"M38965\",\"M4832\",\"M26546\",\"M26508\",\"M843\",\"M27135\",\"M24472\",\"M41399\",\"M6401\",\"M8727\",\"M19175\",\"M34044\",\"M10601\",\"M22156\",\"M13817\",\"M20403\",\"M33554\",\"M17448\",\"M1705\"],\"x\":{\"dtype\":\"f4\",\"bdata\":\"5MWhP78VUcDq9Qu\\u002fzVzSv8gSfz9Qq5dA0aSAQPBxbb9nc7e\\u002fGY0SwH42d76OxBLAfib\\u002fvz\\u002ftq7\\u002fZFRDAqERGQHOq07+SUzvAMnP